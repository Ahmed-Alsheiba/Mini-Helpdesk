# Pi registry htpasswd password (user `stash`, shared with the Stash project). Sourced from
# your shell — export it before deploying; .kamal/hooks/pre-deploy fails fast if it is unset.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$(cat config/master.key)
TUNNEL_TOKEN=$(bin/kamal-secret cloudflare.tunnel_token)
POSTGRES_PASSWORD=$(bin/kamal-secret postgres.password)
